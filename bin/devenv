#!/usr/bin/env bash
#
# bin/devenv - FlowCRM development environment lifecycle (Makefile backend).
#
# Starts the Compose project of this checkout and publishes its HTTP edge
# on 127.0.0.1 using the first port that Docker can actually bind:
#   1. the saved, previously verified port (if inside the range)
#   2. FLOWCRM_PORT_DEFAULT (8080)
#   3. every other port of FLOWCRM_PORT_RANGE (8080-8099), ascending
# FLOWCRM_HTTP_PORT replaces that list with exactly one port (no fallback).
#
# A TCP connect probe only skips ports that are visibly in use; Docker's
# bind decides. Internal services start first and never publish ports, so
# retrying a port only recreates the stateless edge container. Volumes are
# never removed. The verified port is written to .runtime/dev.env only
# after the mapping and the stack's readiness path have been checked.
#
# FLOWCRM_STACK selects the Compose stack: "app" (default, compose.yaml, the
# Symfony, React, PostgreSQL and Caddy stack) or "fixture"
# (compose.fixture.yaml, the BusyBox fixture of the allocator tests).
#
# Exit codes:
#   0 success          1 not running (status, url)   2 Docker error
#   3 no usable port   4 lock timeout                5 missing prerequisite
#   6 safety refusal   64 invalid configuration or usage

set -u

readonly EX_OK=0 EX_NOT_RUNNING=1 EX_DOCKER=2 EX_NO_PORT=3 EX_LOCK=4
readonly EX_PREREQ=5 EX_SAFETY=6 EX_CONFIG=64

readonly RUNTIME_SCHEMA=1
readonly BIND=127.0.0.1
readonly EDGE=edge
readonly EDGE_CONTAINER_PORT=8080
readonly PROJECT_RE='^flowcrm-[0-9a-f]{6}$'
# Bind conflicts as reported by Docker Engine and Docker Desktop. "Ports are
# not available" alone is not enough: Docker Desktop also uses it for
# permission errors, which must not be retried on another port.
readonly CONFLICT_RE='port is already allocated|address already in use'

LOCK_HELD=0
LOCK_KEEP=0
LOCK_TOKEN=
OP_GROUP=
TMP_FILE=
# The database operation (flowcrm-db-roles) in progress, cancelled on a signal.
DB_OP_ID=
# Standard input of the next run_op call (default /dev/null).
OP_STDIN=
# Time limit in seconds of the next run_op call (default none).
OP_TIMEOUT=

log() { printf 'devenv: %s\n' "$*" >&2; }

die() {
  local code=$1
  shift
  printf 'devenv: ERROR: %s\n' "$*" >&2
  exit "$code"
}

# Print a user-supplied value safely in messages (escaped, truncated).
show() {
  local v
  printf -v v '%q' "$1"
  printf '%s' "${v:0:40}"
}

usage() {
  cat <<'EOF'
Usage: bin/devenv <command>

  up       Start the stack and print its URL (port chosen automatically)
  down     Stop and remove this checkout's containers (volumes are kept)
  restart  down + up, preferring the saved port
  status   Show container state and the saved port (exit 1 if not running)
  url      Print the verified URL (exit 1 if not running)
  ports    Show candidate ports and who uses them (read-only)
  logs     Show recent logs (SERVICE=<service>, TAIL=200, FOLLOW=1)
  doctor   Check prerequisites (read-only)
  upgrade-roles
           Move a database volume created before role separation to the
           three roles of ADR-018, after a verified backup (explicit only)
  rotate-db-password
           New password for ROLE=app or ROLE=owner (development only;
           recreates the containers that use it). Run again after an
           interruption to finish the rotation
  rotate-db-password-abort
           Undo an unfinished rotation of ROLE=app or ROLE=owner: the
           database gets the current password back

Configuration: FLOWCRM_STACK (app or fixture), FLOWCRM_PORT_DEFAULT (8080),
FLOWCRM_PORT_RANGE (8080-8099), FLOWCRM_HTTP_PORT (explicit port, no
fallback), FLOWCRM_UP_TIMEOUT (600), FLOWCRM_WAIT_TIMEOUT (60),
FLOWCRM_LOCK_WAIT (120). See docs/dev-environment.md.
EOF
}

# --- validation -------------------------------------------------------------

is_uint() { [[ $1 =~ ^[1-9][0-9]{0,5}$ ]]; }

valid_port() { is_uint "$1" && [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]; }

in_range() { valid_port "$1" && [ "$1" -ge "$PORT_LO" ] && [ "$1" -le "$PORT_HI" ]; }

# A running edge port may be kept only if automatic selection could pick it.
eligible() {
  if [ -n "$OVERRIDE" ]; then [ "$1" = "$OVERRIDE" ]; else in_range "$1"; fi
}

bounded_uint() { # name value max
  is_uint "$2" && [ "$2" -le "$3" ] ||
    die $EX_CONFIG "$1 must be an integer from 1 to $3 (got $(show "$2"))"
}

load_config() {
  local range=${FLOWCRM_PORT_RANGE-8080-8099}
  if [[ ! $range =~ ^([0-9]+)-([0-9]+)$ ]]; then
    die $EX_CONFIG "FLOWCRM_PORT_RANGE must look like 8080-8099 (got $(show "$range"))"
  fi
  PORT_LO=${BASH_REMATCH[1]}
  PORT_HI=${BASH_REMATCH[2]}
  if ! valid_port "$PORT_LO" || ! valid_port "$PORT_HI" || [ "$PORT_LO" -gt "$PORT_HI" ]; then
    die $EX_CONFIG "FLOWCRM_PORT_RANGE needs two ports from 1024 to 65535, low-high, without leading zeros (got $(show "$range"))"
  fi
  [ $((PORT_HI - PORT_LO)) -lt 1000 ] ||
    die $EX_CONFIG "FLOWCRM_PORT_RANGE may span at most 1000 ports"

  PORT_DEFAULT=${FLOWCRM_PORT_DEFAULT-8080}
  in_range "$PORT_DEFAULT" ||
    die $EX_CONFIG "FLOWCRM_PORT_DEFAULT must be a port inside $PORT_LO-$PORT_HI (got $(show "$PORT_DEFAULT"))"

  OVERRIDE=${FLOWCRM_HTTP_PORT-}
  if [ -n "$OVERRIDE" ] && ! valid_port "$OVERRIDE"; then
    die $EX_CONFIG "FLOWCRM_HTTP_PORT must be a port from 1024 to 65535 (got $(show "$OVERRIDE"))"
  fi

  UP_TIMEOUT=${FLOWCRM_UP_TIMEOUT-600}
  WAIT_TIMEOUT=${FLOWCRM_WAIT_TIMEOUT-60}
  LOCK_WAIT=${FLOWCRM_LOCK_WAIT-120}
  bounded_uint FLOWCRM_UP_TIMEOUT "$UP_TIMEOUT" 3600
  bounded_uint FLOWCRM_WAIT_TIMEOUT "$WAIT_TIMEOUT" 600
  bounded_uint FLOWCRM_LOCK_WAIT "$LOCK_WAIT" 3600
}

# --- paths and project identity ---------------------------------------------

sha256_prefix() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum
  else
    printf '%s' "$1" | shasum -a 256
  fi | cut -c1-6
}

# Stack definitions (docs/architecture/development-lifecycle-contract.md,
# section 10). Both publish the service "edge" on container port 8080.
select_stack() {
  STACK=${FLOWCRM_STACK:-app}
  case $STACK in
    app)
      COMPOSE_FILE_NAME=compose.yaml
      INTERNAL_SERVICES='db api web'
      READY_PATH=/health/ready
      READY_BODY='{"status":"ready"}'
      LOG_SERVICES='edge web api db'
      SECRETS='db_password app_secret db_owner_password db_app_password'
      # The database volume was initialised with these secrets.
      SECRET_VOLUMES='db_password=db-data db_owner_password=db-data db_app_password=db-data'
      # The migrate job (profile migrate) is built with the stack, never started by up.
      COMPOSE_PROFILES_VALUE=dev,migrate
      MIGRATIONS=1
      ROLES=1
      URL_LABEL='FlowCRM'
      ;;
    fixture)
      COMPOSE_FILE_NAME=compose.fixture.yaml
      INTERNAL_SERVICES=state
      COMPOSE_PROFILES_VALUE=
      READY_PATH=/health
      READY_BODY=ok
      LOG_SERVICES='edge state'
      SECRETS=
      SECRET_VOLUMES=
      MIGRATIONS=
      ROLES=
      URL_LABEL='FlowCRM development fixture'
      ;;
    *) die $EX_CONFIG "FLOWCRM_STACK must be app or fixture (got $(show "$STACK"))" ;;
  esac
}

init_paths() {
  local here
  here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P) || die $EX_PREREQ "cannot resolve the script directory"
  ROOT=$(cd -P "$here/.." && pwd -P) || die $EX_PREREQ "cannot resolve the checkout directory"
  select_stack
  COMPOSE_FILE=$ROOT/$COMPOSE_FILE_NAME
  RUNTIME_DIR=$ROOT/.runtime
  SECRETS_DIR=$RUNTIME_DIR/secrets
  STATE_FILE=$RUNTIME_DIR/dev.env
  LOCK_DIR=$RUNTIME_DIR/lock
  # The security gate lives in its own directory, which the edge mounts
  # read-only: while the file exists the edge serves nothing but its health
  # paths (docker/edge/common.caddy, ADR-018).
  GATE_DIR=$RUNTIME_DIR/gate
  GATE_FILE=$GATE_DIR/security-gate
  SELF=$here/${BASH_SOURCE[0]##*/}
  PROJECT=flowcrm-$(sha256_prefix "$ROOT")
  [[ $PROJECT =~ $PROJECT_RE ]] || die $EX_PREREQ "could not derive a project name"
}

ensure_runtime_dir() {
  [ ! -L "$RUNTIME_DIR" ] || die $EX_SAFETY ".runtime is a symbolic link; refusing to write through it"
  mkdir -p "$RUNTIME_DIR" || die $EX_SAFETY "cannot create $RUNTIME_DIR"
  [ ! -L "$GATE_DIR" ] || die $EX_SAFETY ".runtime/gate is a symbolic link; refusing to write through it"
  # World-readable (it holds only the reason): the edge's unprivileged user
  # must be able to see the gate, or it would serve.
  { mkdir -p "$GATE_DIR" && chmod 0755 "$GATE_DIR"; } || die $EX_SAFETY "cannot create $GATE_DIR"
  # A gate recorded by an earlier version, at .runtime/security-gate.
  if [ -f "$RUNTIME_DIR/security-gate" ] && [ ! -e "$GATE_FILE" ]; then
    { chmod 0644 "$RUNTIME_DIR/security-gate" && mv -f "$RUNTIME_DIR/security-gate" "$GATE_FILE"; } ||
      die $EX_SAFETY "cannot move the security gate to $GATE_FILE"
  fi
}

# Records the security gate from standard input, atomically (rename) and
# readable by the edge.
write_gate() {
  local tmp
  tmp=$(mktemp "$GATE_DIR/.security-gate.XXXXXX") || return 1
  if cat >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$GATE_FILE"; then return 0; fi
  rm -f "$tmp"
  return 1
}

new_tmp() { # prefix -> sets TMP_FILE (removed on exit); removes the previous one
  [ -z "$TMP_FILE" ] || rm -f "$TMP_FILE"
  TMP_FILE=$(mktemp "$RUNTIME_DIR/.$1.XXXXXX") || die $EX_SAFETY "cannot create a temporary file in .runtime"
}

# --- generated secrets --------------------------------------------------------
# Random per-checkout secrets in .runtime/secrets (directory 0700, files
# 0444 so the unprivileged container users can read the bind-mounted copy).
# An existing secret is never replaced: the database volume was initialised
# with it. The role secrets (db_owner_password, db_app_password, ADR-018)
# must be 48 lowercase hex characters; for an existing volume they are
# created only by upgrade-roles (the argument allow-new-role-secrets, never
# an environment variable) or replaced by rotate-db-password, never by up.

is_role_secret() { case $1 in db_owner_password | db_app_password) return 0 ;; esac; return 1; }
role_of() { local r=${1#db_}; printf '%s' "${r%_password}"; } # db_app_password -> app

ensure_secrets() { # [allow-new-role-secrets]
  local name file tmp volume allow=${1-}
  [ -n "$SECRETS" ] || return 0
  ensure_runtime_dir
  [ ! -L "$SECRETS_DIR" ] || die $EX_SAFETY ".runtime/secrets is a symbolic link; refusing to use it"
  if [ ! -e "$SECRETS_DIR" ]; then
    (umask 077 && mkdir "$SECRETS_DIR") || die $EX_SAFETY "cannot create $SECRETS_DIR"
  fi
  [ -d "$SECRETS_DIR" ] && [ -O "$SECRETS_DIR" ] ||
    die $EX_SAFETY ".runtime/secrets is not a directory owned by $(id -un); refusing to use it"
  # Only the owner may list or read the secrets (a pre-existing 0755
  # directory would expose the 0444 files to other local users).
  chmod 0700 "$SECRETS_DIR" || die $EX_SAFETY "cannot restrict the permissions of $SECRETS_DIR"
  for name in $SECRETS; do
    file=$SECRETS_DIR/$name
    if [ -L "$file" ] || { [ -e "$file" ] && [ ! -f "$file" ]; }; then
      die $EX_SAFETY ".runtime/secrets/$name is not a regular file; refusing to use it"
    fi
    if [ -s "$file" ]; then
      [ -O "$file" ] || die $EX_SAFETY ".runtime/secrets/$name is not owned by $(id -un); refusing to use it"
      if is_role_secret "$name" && ! [[ $(cat "$file") =~ ^[0-9a-f]{48}$ ]]; then
        die $EX_SAFETY ".runtime/secrets/$name is malformed (expected 48 lowercase hex characters); refusing to use it. Restore it from a backup, or set a new password: make db-rotate-password ROLE=$(role_of "$name")"
      fi
      chmod 0444 "$file" || die $EX_SAFETY "cannot set the permissions of .runtime/secrets/$name"
      continue
    fi
    volume=$(bound_volume "$name")
    if [ -n "$volume" ] && docker volume inspect "${PROJECT}_$volume" >/dev/null 2>&1; then
      if is_role_secret "$name"; then
        [ "$allow" = allow-new-role-secrets ] ||
          die $EX_SAFETY ".runtime/secrets/$name is missing, but the volume ${PROJECT}_$volume exists, so none was generated. A volume created before role separation is upgraded explicitly: make db-upgrade-roles (ADR-018). For an upgraded volume, restore the file from a backup, or set a new password: make db-rotate-password ROLE=$(role_of "$name")"
      else
        die $EX_SAFETY ".runtime/secrets/$name is missing, but the volume ${PROJECT}_$volume was initialised with it; a new secret would not match, so none was generated. Restore .runtime/secrets/$name from a backup, or reset the data deliberately as described in README.md (Data persistence and reset), which deletes it"
      fi
    fi
    tmp=$(mktemp "$SECRETS_DIR/.$name.XXXXXX") || die $EX_SAFETY "cannot create a temporary file in $SECRETS_DIR"
    TMP_FILE=$tmp
    if ! od -An -N24 -tx1 /dev/urandom | tr -d ' \n' >"$tmp" || [ ! -s "$tmp" ] ||
      ! chmod 0444 "$tmp" || ! mv -f "$tmp" "$file"; then
      die $EX_SAFETY "could not create the secret .runtime/secrets/$name"
    fi
    TMP_FILE=
    log "generated the local secret .runtime/secrets/$name"
  done
}

bound_volume() { # secret name: the volume initialised with it, if any
  local pair
  for pair in $SECRET_VOLUMES; do
    [ "${pair%%=*}" = "$1" ] && printf '%s' "${pair#*=}" && return 0
  done
  return 0
}

# --- runtime state (parsed as data; never sourced) --------------------------

read_state() {
  STATE_STATUS=absent
  STATE_PORT=
  STATE_PROJECT=
  local line key val size bad='' schema='' project='' bind='' port=''
  [ -e "$STATE_FILE" ] || [ -L "$STATE_FILE" ] || return 0
  if [ -L "$STATE_FILE" ] || [ ! -f "$STATE_FILE" ]; then
    STATE_STATUS=invalid
    return 0
  fi
  size=$(wc -c <"$STATE_FILE" | tr -d ' ')
  if [ "$size" -gt 4096 ]; then
    STATE_STATUS=invalid
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in '' | '#'*) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    if [ "$key" = "$line" ]; then
      bad=1
      continue
    fi
    case $key in
      RUNTIME_SCHEMA) schema=$val ;;
      COMPOSE_PROJECT_NAME) project=$val ;;
      FLOWCRM_HTTP_BIND) bind=$val ;;
      FLOWCRM_HTTP_PORT) port=$val ;;
      *) bad=1 ;;
    esac
  done <"$STATE_FILE"
  if [ -n "$bad" ] || [ "$schema" != "$RUNTIME_SCHEMA" ] || [[ ! $project =~ $PROJECT_RE ]] ||
    [ "$bind" != "$BIND" ] || ! valid_port "$port"; then
    STATE_STATUS=invalid
    return 0
  fi
  if [ "$project" != "$PROJECT" ]; then
    STATE_STATUS=foreign
    STATE_PROJECT=$project
    return 0
  fi
  STATE_STATUS=valid
  STATE_PORT=$port
}

write_state() {
  ensure_runtime_dir
  new_tmp dev.env
  if ! printf '%s\n' \
    '# Written by bin/devenv after a verified start. Local only; do not commit.' \
    "RUNTIME_SCHEMA=$RUNTIME_SCHEMA" \
    "COMPOSE_PROJECT_NAME=$PROJECT" \
    "FLOWCRM_HTTP_BIND=$BIND" \
    "FLOWCRM_HTTP_PORT=$1" >"$TMP_FILE" || ! mv -f "$TMP_FILE" "$STATE_FILE"; then
    die $EX_SAFETY "could not write $STATE_FILE"
  fi
  TMP_FILE=
  STATE_STATUS=valid
  STATE_PORT=$1
}

# --- per-checkout lock --------------------------------------------------------
# A directory created with mkdir (atomic). The owner record names host, PID
# and the PID's start identity. While the lock is held, every mutating
# Docker Compose call runs in its own process group, whose leader is
# recorded in lock/op (see compose_op and run_recorded): neither SIGKILL of
# devenv nor of the Docker CLI stops the Compose plugin, so the lock is only
# reaped when the owner, the recorded leader and every member of its process
# group provably ended. Unverifiable records keep the lock (exit 4 after
# FLOWCRM_LOCK_WAIT). Locks from another host are never reaped
# automatically.

host_id() { hostname 2>/dev/null || uname -n; }

is_pid() { [[ $1 =~ ^[1-9][0-9]{0,9}$ ]]; }

# Start identity of a process, independent of the caller's locale and time
# zone: on Linux the boot id and the start time in clock ticks since boot
# (unaffected by changes of the wall clock), elsewhere ps lstart rendered in
# the C locale and UTC. Empty if the process does not exist.
proc_start() {
  local stat boot f
  if [ -r /proc/sys/kernel/random/boot_id ] && stat=$(cat "/proc/$1/stat" 2>/dev/null); then
    boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    read -r -a f <<<"${stat##*) }"
    if [ -n "$boot" ] && [[ ${f[19]-} =~ ^[0-9]+$ ]]; then printf 'linux:%s:%s\n' "$boot" "${f[19]}"; fi
    return 0
  fi
  stat=$(LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//')
  [ -z "$stat" ] || printf 'lstart:%s\n' "$stat"
}

# Returns 1 only when the recorded process provably ended: its PID is gone
# or now belongs to a process with another start identity of the same kind.
# A missing, malformed or incomparable record counts as running.
recorded_alive() { # pid pstart
  local now
  is_pid "$1" && command -v ps >/dev/null 2>&1 || return 0
  ps -p "$1" >/dev/null 2>&1 || return 1
  case $2 in linux:* | lstart:*) ;; *) return 0 ;; esac
  now=$(proc_start "$1")
  [ -n "$now" ] && [ "${now%%:*}" = "${2%%:*}" ] || return 0
  [ "$now" = "$2" ]
}

# True while a process group whose leader was recorded has members although
# the leader itself ended. A process group ID is not reused while the group
# has members, so such members belong to the recorded operation; if a
# process with that PID exists again, the recorded group already ended.
group_outlives_leader() { # pgid
  is_pid "$1" && ! ps -p "$1" >/dev/null 2>&1 && kill -0 -- "-$1" 2>/dev/null
}

older_than_a_minute() { [ -n "$(find "$1" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }

new_token() { od -An -N8 -tx1 /dev/urandom | tr -d ' \n'; }

write_lock_owner() {
  new_tmp lock-owner
  printf '%s\n' "token=$LOCK_TOKEN" "host=$(host_id)" \
    "pid=$$" "pstart=$(proc_start $$)" "command=$1" >"$TMP_FILE" &&
    mv -f "$TMP_FILE" "$LOCK_DIR/owner"
  local rc=$?
  TMP_FILE=
  return $rc
}

# Sets REC_TOKEN, REC_HOST, REC_PID, REC_PSTART and REC_PGID from a lock record.
read_record() {
  local line
  REC_TOKEN='' REC_HOST='' REC_PID='' REC_PSTART='' REC_PGID=''
  while IFS= read -r line; do
    case $line in
      token=*) REC_TOKEN=${line#token=} ;;
      host=*) REC_HOST=${line#host=} ;;
      pid=*) REC_PID=${line#pid=} ;;
      pstart=*) REC_PSTART=${line#pstart=} ;;
      pgid=*) REC_PGID=${line#pgid=} ;;
    esac
  done <"$1"
}

# Sets LOCK_STATE (active|stale|foreign), LOCK_INFO and OBSERVED_TOKEN.
lock_status() {
  local pid
  LOCK_INFO='owner not recorded yet'
  OBSERVED_TOKEN=
  if [ ! -f "$LOCK_DIR/owner" ]; then
    if [ -d "$LOCK_DIR" ] && older_than_a_minute "$LOCK_DIR"; then LOCK_STATE=stale; else LOCK_STATE=active; fi
    return 0
  fi
  read_record "$LOCK_DIR/owner" 2>/dev/null
  OBSERVED_TOKEN=$REC_TOKEN
  pid=$REC_PID
  LOCK_INFO="pid $(show "$pid") on host $(show "$REC_HOST")"
  if [ "$REC_HOST" != "$(host_id)" ]; then
    LOCK_STATE=foreign
    return 0
  fi
  LOCK_STATE=active
  case $REC_PSTART in
    linux:* | lstart:*) ;;
    *) LOCK_INFO="$LOCK_INFO; the record has no start identity this bin/devenv can verify (for example from an older version)" ;;
  esac
  recorded_alive "$REC_PID" "$REC_PSTART" && return 0
  # The owner ended; a Docker command it started may still be running.
  if [ -e "$LOCK_DIR/op" ]; then
    read_record "$LOCK_DIR/op" 2>/dev/null
    if recorded_alive "$REC_PID" "$REC_PSTART"; then
      LOCK_INFO="Docker command pid $(show "$REC_PID") of the ended devenv pid $(show "$pid") is still running"
      return 0
    fi
    if [ "$REC_PGID" = "$REC_PID" ] && group_outlives_leader "$REC_PGID"; then
      LOCK_INFO="Docker Compose processes in process group $(show "$REC_PGID") of the ended devenv pid $(show "$pid") are still running"
      return 0
    fi
  fi
  LOCK_STATE=stale
}

# Remove a stale lock under a second mkdir guard, re-checking that it is
# still the same stale owner, so concurrent reapers cannot remove a lock
# that another process acquired in the meantime.
reap_lock() {
  local guard=$RUNTIME_DIR/lock.reap observed=$OBSERVED_TOKEN
  if ! mkdir "$guard" 2>/dev/null; then
    # A guard older than a minute belongs to a reaper that died: remove it
    # and take the guard at once, so the stale lock is reaped in this
    # attempt instead of only after the next pass of acquire_lock (which
    # may come after its deadline).
    if ! older_than_a_minute "$guard" || ! rm -rf "$guard" || ! mkdir "$guard" 2>/dev/null; then
      return 1
    fi
  fi
  lock_status
  if [ "$LOCK_STATE" = stale ] && [ "$OBSERVED_TOKEN" = "$observed" ]; then
    rm -rf "$LOCK_DIR" && log "removed a stale lock ($LOCK_INFO)"
  fi
  rmdir "$guard"
}

acquire_lock() {
  local deadline=$((SECONDS + LOCK_WAIT)) announced='' reaps=0
  LOCK_TOKEN=$(new_token)
  while :; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      LOCK_HELD=1
      write_lock_owner "$1" || die $EX_SAFETY "could not record the lock owner"
      return 0
    fi
    lock_status
    if [ "$LOCK_STATE" = stale ] && [ "$reaps" -lt 3 ]; then
      reaps=$((reaps + 1))
      reap_lock && continue
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      [ "$LOCK_STATE" != foreign ] ||
        log "the lock belongs to another host; remove .runtime/lock manually only if no devenv command runs there"
      die $EX_LOCK "another devenv command holds .runtime/lock ($LOCK_INFO); gave up after ${LOCK_WAIT}s"
    fi
    if [ -z "$announced" ]; then
      log "waiting for another devenv command in this checkout ($LOCK_INFO)"
      announced=1
    fi
    sleep 1
  done
}

# Internal command, started by compose_op as the leader of a new process
# group: record this process (PID, start identity, process group) in
# lock/op, then exec the Docker command in the same process. The record is
# written under the reap guard and only while the lock still belongs to the
# caller's token, so a concurrent reaper either sees the record or the
# command never starts.
run_recorded() { # lock-dir token command...
  local dir=$1 token=$2 guard i=0 tmp='' ok='' pgid held=''
  shift 2
  pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')
  [ "$pgid" = "$$" ] ||
    die $EX_SAFETY "the Docker command must lead its own process group (pid $$, group $(show "$pgid")); it was not run"
  guard=${dir%/*}/lock.reap
  # A signal (forwarded to this group by devenv) must not leave the guard
  # or a partial record behind; only a guard held by this process is removed.
  trap 'leave_recording 130' INT
  trap 'leave_recording 143' TERM
  trap 'leave_recording 129' HUP
  leave_recording() {
    [ -z "$tmp" ] || rm -f "$tmp"
    [ -z "$held" ] || rmdir "$guard" 2>/dev/null
    exit "$1"
  }
  until mkdir "$guard" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 50 ] || die $EX_LOCK "the reap guard of .runtime/lock is busy; the Docker command was not run"
    sleep 0.1
  done
  held=1
  if [ "$(sed -n 's/^token=//p' "$dir/owner" 2>/dev/null)" = "$token" ] &&
    tmp=$(mktemp "$dir/.op.XXXXXX" 2>/dev/null); then
    if printf '%s\n' "pid=$$" "pstart=$(proc_start $$)" "pgid=$pgid" >"$tmp" && mv -f "$tmp" "$dir/op"; then ok=1; else rm -f "$tmp"; fi
  fi
  tmp=''
  rmdir "$guard"
  held=''
  trap - INT TERM HUP
  [ -n "$ok" ] || die $EX_LOCK "this command no longer holds .runtime/lock; the Docker command was not run"
  exec "$@"
}

# Run a command as a background job with job control, i.e. as the leader
# of its own process group, recorded in lock/op through run_recorded. Wait
# for the job, then for every remaining member of its group (a Compose
# plugin outlives a killed Docker CLI). If members remain after
# FLOWCRM_LOCK_WAIT seconds, fail and keep the lock, so no other command can
# start while they run.
run_op() { # command...
  local rc watchdog=''
  set -m
  "$BASH" "$SELF" __run-recorded "$LOCK_DIR" "$LOCK_TOKEN" "$@" <"${OP_STDIN:-/dev/null}" 8>&- 9>&- &
  OP_GROUP=$!
  set +m
  if [ -n "$OP_TIMEOUT" ]; then
    (sleep "$OP_TIMEOUT" && kill -TERM -- "-$OP_GROUP") >/dev/null 2>&1 8>&- 9>&- &
    watchdog=$!
  fi
  wait "$OP_GROUP"
  rc=$?
  [ -z "$watchdog" ] || kill "$watchdog" 2>/dev/null
  finish_op
  return "$rc"
}

finish_op() {
  local g=$OP_GROUP deadline=$((SECONDS + LOCK_WAIT))
  [ -n "$g" ] || return 0
  while kill -0 -- "-$g" 2>/dev/null; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      LOCK_KEEP=1
      die $EX_LOCK "processes of this command's Docker Compose call (process group $g) are still running after ${LOCK_WAIT}s; .runtime/lock is kept until they end"
    fi
    sleep 0.1
  done
  OP_GROUP=
}

# Signals reach devenv but not the Docker process group: forward them, wait
# for the group to end, then exit (the lock is released by on_exit). Ending
# `docker compose exec` does not end the process inside the container, so
# an interrupted database operation is cancelled explicitly, and the lock is
# released only after it ended.
on_signal() { # exit-code signal
  trap '' INT TERM HUP
  # The signal may arrive inside a call whose output is redirected to a
  # temporary file; report on the command's own stdout and stderr.
  exec 1>&8 2>&9
  if [ -n "$OP_GROUP" ]; then
    kill -"$2" -- "-$OP_GROUP" 2>/dev/null
    finish_op
  fi
  [ -z "$DB_OP_ID" ] || cancel_db_op
  exit "$1"
}

# Returns non-zero when the operation could not be confirmed as ended and
# the security gate could not be recorded either (reported on stderr).
cancel_db_op() {
  local id=$DB_OP_ID rc
  DB_OP_ID=
  OP_STDIN=
  log "stopping the interrupted database operation; an open transaction is rolled back"
  # Bounded: flowcrm-db-roles waits at most 30 s; the call itself at most 45 s.
  OP_TIMEOUT=45 compose_op exec -T db flowcrm-db-roles cancel "$id" >/dev/null 2>&1
  rc=$?
  if [ "$rc" -eq 0 ]; then
    log "the interrupted database operation ended; nothing of it can commit any more"
    return 0
  fi
  # Unconfirmed: the operation may still be alive (for example while the db
  # container cannot be reached) and commit later. Fail closed until a
  # make up has ended it, or found it finished, and passed every check.
  # A failed listing is never taken for "no edge" (see stop_edge_after).
  local edge='' ids listed=yes
  ids=$(compose ps --quiet "$EDGE" 2>/dev/null) || listed=no
  if [ -n "$ids" ] || grep -qx edge "$GATE_FILE" 2>/dev/null; then edge=edge; fi
  local recorded=yes
  printf '%s\n' "an interrupted database operation ($id) could not be confirmed as ended; make up ends it (or finds it finished) and checks the roles and privileges before the stack is served again" ${edge:+"$edge"} | write_gate || recorded=no
  if [ "$recorded" = yes ]; then
    log "WARNING: could not confirm that the interrupted database operation ended (exit $rc); the stack is blocked until make up has ended it and passed every check"
  else
    log "ERROR: could not confirm that the interrupted database operation ended (exit $rc), and the security gate could not be recorded in $GATE_FILE; $(gate_unrecorded_status): stop the stack (make down) and run make up"
  fi
  if stop_edge_after "$listed" "$ids" "an interrupted database operation may still be running"; then
    log "stopped the edge: an interrupted database operation may still be running"
  elif [ -n "$EDGE_STOP_RC" ]; then
    log "WARNING: could not confirm that the edge of $PROJECT stopped (docker compose stop exited with status $EDGE_STOP_RC); stop the stack with make down"
  fi
  [ "$recorded" = yes ]
}

# Test-only fault injection (FLOWCRM_DEVENV_FAULT=<point>[:kill|:int], used
# by tests/app/stack.sh): stop with SIGTERM (or SIGKILL, which runs no
# handler, or SIGINT) at a named point, exactly as an interrupted or killed
# command would. Points: rotate-after-pending, rotate-after-db,
# rotate-after-promote, upgrade-after-backup, up-after-migrations,
# restore-before-edge, edge-started; upgrade-corrupt-copy damages the host
# copy of the backup instead.
fault_point() { # name
  case ${FLOWCRM_DEVENV_FAULT-} in
    "$1")
      log "test fault injection: SIGTERM at $1"
      kill -TERM $$
      ;;
    "$1:kill")
      log "test fault injection: SIGKILL at $1"
      kill -KILL $$
      ;;
    "$1:int")
      log "test fault injection: SIGINT at $1"
      kill -INT $$
      ;;
  esac
}

release_lock() {
  [ "$LOCK_HELD" = 1 ] || return 0
  if [ "$LOCK_KEEP" = 1 ]; then
    log "kept .runtime/lock: Docker Compose processes of this command are still running"
    LOCK_HELD=0
    return 0
  fi
  local t
  t=$(sed -n 's/^token=//p' "$LOCK_DIR/owner" 2>/dev/null)
  if [ -z "$t" ] || [ "$t" = "$LOCK_TOKEN" ]; then rm -rf "$LOCK_DIR"; fi
  LOCK_HELD=0
}

on_exit() {
  release_lock
  if [ -n "$TMP_FILE" ]; then rm -f "$TMP_FILE"; fi
}

# --- Docker -----------------------------------------------------------------

# Read-only Docker Compose call (ps, port, logs).
compose() {
  COMPOSE_PROFILES=$COMPOSE_PROFILES_VALUE FLOWCRM_HTTP_PORT=$COMPOSE_PORT FLOWCRM_HTTP_BIND=$BIND FLOWCRM_GATE_DIR=$GATE_DIR docker compose \
    --project-name "$PROJECT" --project-directory "$ROOT" --file "$COMPOSE_FILE" "$@"
}

# Mutating Docker Compose call (up, down, rm); only while the lock is held.
compose_op() {
  [ "$LOCK_HELD" = 1 ] || die $EX_SAFETY "internal error: mutating Docker Compose call without the lock"
  COMPOSE_PROFILES=$COMPOSE_PROFILES_VALUE FLOWCRM_HTTP_PORT=$COMPOSE_PORT FLOWCRM_HTTP_BIND=$BIND FLOWCRM_GATE_DIR=$GATE_DIR run_op docker compose \
    --project-name "$PROJECT" --project-directory "$ROOT" --file "$COMPOSE_FILE" "$@"
}

# Describes a failed docker compose exit status for messages.
compose_failure() { # status
  if [ "$1" -gt 128 ]; then
    printf 'docker compose was terminated by signal %s' $(($1 - 128))
  else
    printf 'docker compose exited with status %s; its error is shown above' "$1"
  fi
}

preflight() {
  command -v docker >/dev/null 2>&1 || die $EX_PREREQ "docker CLI not found (see make doctor)"
  docker compose version >/dev/null 2>&1 || die $EX_PREREQ "Docker Compose v2 plugin not found (see make doctor)"
  docker info >/dev/null 2>&1 || die $EX_PREREQ "Docker daemon is not reachable (see make doctor)"
  [ -f "$COMPOSE_FILE" ] || die $EX_PREREQ "missing $COMPOSE_FILE"
}

# Refuse to manage resources that do not belong to this checkout.
require_owned_project() {
  if [ "$STATE_STATUS" = foreign ]; then
    die $EX_SAFETY ".runtime/dev.env names project $STATE_PROJECT but this checkout is $PROJECT; if it was copied from another checkout, delete .runtime/dev.env"
  fi
  local out id wd files
  out=$(docker ps --all --filter "label=com.docker.compose.project=$PROJECT" \
    --format '{{.ID}}|{{.Label "com.docker.compose.project.working_dir"}}|{{.Label "com.docker.compose.project.config_files"}}') ||
    die $EX_DOCKER "could not list containers"
  while IFS='|' read -r id wd files; do
    [ -n "$id" ] || continue
    [ "$wd" = "$ROOT" ] ||
      die $EX_SAFETY "container $id uses project name $PROJECT but belongs to $(show "$wd"); refusing to manage it"
    # Both stacks share the project name of the checkout; the Compose file
    # recorded on each container tells them apart.
    [ "$files" = "$COMPOSE_FILE" ] ||
      die $EX_SAFETY "project $PROJECT has containers of another stack (container $id from $(show "${files##*/}")); this command manages FLOWCRM_STACK=$STACK ($COMPOSE_FILE_NAME). Stop them first with: FLOWCRM_STACK=$(stack_of_file "$files") make down"
  done <<EOF
$out
EOF
}

stack_of_file() { # compose file path: the stack that uses it
  case ${1##*/} in
    compose.yaml) printf app ;;
    compose.fixture.yaml) printf fixture ;;
    *) printf unknown ;;
  esac
}

# Sets EDGE_ID, EDGE_RUNNING (true|false), EDGE_HEALTH and EDGE_PORT.
edge_state() {
  local s m
  EDGE_RUNNING=false
  EDGE_HEALTH=none
  EDGE_PORT=
  EDGE_ID=$(compose ps --all --quiet "$EDGE" 2>/dev/null | head -n 1)
  [ -n "$EDGE_ID" ] || return 0
  s=$(docker inspect -f '{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$EDGE_ID" 2>/dev/null) || return 0
  EDGE_RUNNING=${s%% *}
  EDGE_HEALTH=${s#* }
  [ "$EDGE_RUNNING" = true ] || return 0
  m=$(compose port "$EDGE" "$EDGE_CONTAINER_PORT" 2>/dev/null | head -n 1)
  case $m in "$BIND:"*) EDGE_PORT=${m#"$BIND:"} ;; esac
  valid_port "$EDGE_PORT" || EDGE_PORT=
}

# The running edge (EDGE_ID) enforces the security gate: it mounts this
# checkout's gate directory at /run/flowcrm-gate (compose.yaml,
# FLOWCRM_GATE_DIR). An edge created before the gate mount existed, or by a
# plain docker compose up (docker/edge/no-gate), does not, and is never
# reported as running unchanged. Docker Desktop may show the source with a
# prefix. Only the application stack has a gate.
edge_mounts_gate() {
  local src
  [ "$STACK" = app ] || return 0
  src=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/run/flowcrm-gate"}}{{.Source}}{{end}}{{end}}' "$EDGE_ID" 2>/dev/null) || return 1
  case $src in *"$GATE_DIR") return 0 ;; esac
  return 1
}

# A hint only: something accepts connections on the port.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null && return 0
  (exec 3<>"/dev/tcp/::1/$1") 2>/dev/null && return 0
  return 1
}

# The readiness path must answer 200 with the stack's own body: any other
# 200 (for example the SPA of the other stack) is not this stack's readiness.
http_ok() {
  (
    exec 3<>"/dev/tcp/$BIND/$1" || exit 1
    printf 'GET %s HTTP/1.0\r\nHost: %s:%s\r\nConnection: close\r\n\r\n' "$READY_PATH" "$BIND" "$1" >&3
    IFS= read -r -t 5 line <&3 || exit 1
    case $line in "HTTP/1."[01]" 200"*) ;; *) exit 1 ;; esac
    while IFS= read -r -t 5 line <&3; do
      case $line in '' | $'\r') break ;; esac
    done
    body=
    IFS= read -r -t 5 body <&3 || [ -n "$body" ] || exit 1
    case $body in *"$READY_BODY"*) exit 0 ;; esac
    exit 1
  ) 2>/dev/null
}

wait_http() {
  local i=0
  while [ "$i" -lt 20 ]; do
    http_ok "$1" && return 0
    i=$((i + 1))
    sleep 0.5
  done
  return 1
}

is_port_conflict() { grep -Eiq "$CONFLICT_RE" "$1"; }

# P2: build this project's images (a no-op for services without a build).
build_images() {
  local rc
  new_tmp compose-err
  log "building images (the first build can take several minutes)"
  compose_op build >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    tail -n 30 "$TMP_FILE" >&2
    die $EX_DOCKER "building the images failed: $(compose_failure "$rc"); running containers were not changed"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

start_internal() {
  local rc
  new_tmp compose-err
  # shellcheck disable=SC2086 # INTERNAL_SERVICES is a fixed word list
  compose_op up --detach --wait --wait-timeout "$WAIT_TIMEOUT" $INTERNAL_SERVICES >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    tail -n 20 "$TMP_FILE" >&2
    die $EX_DOCKER "starting the internal services ($INTERNAL_SERVICES) failed: $(compose_failure "$rc"); they publish no host port, so no other port was tried; containers that were created are kept for make status and make logs"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

# Applies pending Doctrine migrations with the one-off migrate job (as
# flowcrm_owner), under the lock and in a recorded process group like every
# other mutating call. Sets MIGRATED=1 when migrations were applied.
apply_migrations() {
  local rc
  MIGRATED=
  [ -n "$MIGRATIONS" ] || return 0
  new_tmp compose-err
  compose_op exec -T api php bin/console doctrine:migrations:up-to-date --no-interaction >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    # Migrations may change tables and grants.
    protect_for "applying database migrations"
    log "applying pending database migrations"
    # The migrate job connects as the schema owner; the api never holds its password.
    compose_op run --rm --no-deps migrate >/dev/null 2>"$TMP_FILE"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      tail -n 20 "$TMP_FILE" >&2
      die $EX_DOCKER "applying the database migrations failed: $(compose_failure "$rc"); the saved state was not changed; the output of the migrate job is shown above"
    fi
    MIGRATED=1
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

# "service=container-id" lines of this project, for change reports.
# --- database roles (ADR-018) -------------------------------------------------

start_db() {
  local rc
  [ -n "$ROLES" ] || return 0
  new_tmp compose-err
  compose_op up --detach --wait --wait-timeout "$WAIT_TIMEOUT" db >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    tail -n 20 "$TMP_FILE" >&2
    die $EX_DOCKER "starting the database failed: $(compose_failure "$rc")"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

# flowcrm-db-roles in the db container as operation DB_OP_ID (its database
# sessions are named after it, see docker/db/flowcrm-db-roles); output in
# $TMP_FILE; standard input from OP_STDIN when set. A signal cancels it.
db_roles() { # command...
  local rc
  new_tmp db-roles
  DB_OP_ID=$(new_token)
  compose_op exec -T -e "FLOWCRM_OP_ID=$DB_OP_ID" db flowcrm-db-roles "$@" >"$TMP_FILE" 2>&1
  rc=$?
  DB_OP_ID=
  return "$rc"
}

# A failed security gate (database roles, runtime privileges): a stack that
# was already running must not keep serving requests, so its edge is
# stopped. The database, its volume, the other containers and the saved
# port are kept for the recovery. The reason is recorded for make status
# and make url; the next make up that passes every gate removes it.
gate_failed() { # exit-code message
  local ids listed=yes edge=''
  # A failed listing is never taken for "no edge" (see stop_edge_after).
  ids=$(compose ps --quiet "$EDGE" 2>/dev/null) || listed=no
  if [ -n "$ids" ] || grep -qx edge "$GATE_FILE" 2>/dev/null; then edge=edge; fi
  # Fail closed: the original failure is still reported (and its exit code
  # kept), but never without saying that the gate is not recorded.
  local recorded=yes
  { printf '%s\n' "$2" | head -c 300 | tr -d '\n'; printf '\n'; [ -z "$edge" ] || printf 'edge\n'; } | write_gate || recorded=no
  [ "$recorded" = yes ] ||
    log "ERROR: the security gate could not be recorded in $GATE_FILE; $(gate_unrecorded_status): stop the stack (make down) until make up passes"
  if stop_edge_after "$listed" "$ids" "after a failed security gate"; then
    log "stopped the edge: the stack failed a security gate and no longer serves requests (the database and its volume are kept)"
  elif [ -n "$EDGE_STOP_RC" ]; then
    if gate_blocks; then
      log "WARNING: could not confirm that the edge of $PROJECT stopped after a failed security gate (docker compose stop exited with status $EDGE_STOP_RC); it answers only with the gate's 503 (checked); stop it with make down"
    else
      log "WARNING: could not confirm that the edge of $PROJECT stopped after a failed security gate (docker compose stop exited with status $EDGE_STOP_RC), and it was not seen blocking requests; stop the stack now: make down"
    fi
  fi
  die "$1" "$2"
}

# After the gate was recorded by gate_failed or cancel_db_op: stop the edge
# listed before (listed=yes, its IDs) and confirm it with edges_stopped.
# A listing that failed (listed=no) is never taken for "no edge": it is
# reported, and the edge is stopped anyway, which cannot be confirmed
# without IDs. The "edge" line is not added for an unknown state; the
# recorded gate blocks either way. Returns 0 when the stop was confirmed;
# otherwise EDGE_STOP_RC is the stop's exit status, or empty when no edge
# was listed (nothing to stop).
stop_edge_after() { # listed(yes|no) ids why
  EDGE_STOP_RC=
  if [ "$1" = no ]; then
    log "WARNING: could not list the containers of $PROJECT, so it is not known whether its edge serves ($3); stopping it anyway"
  elif [ -z "$2" ]; then
    return 1
  fi
  compose_op stop "$EDGE" >/dev/null 2>&1
  EDGE_STOP_RC=$?
  # shellcheck disable=SC2086 # one container ID per word
  [ "$1" = yes ] && edges_stopped $2
}

# Before anything changes roles, passwords, ownership or grants (role
# corrections, migrations, the upgrade, a rotation): record the security
# gate durably (atomic rename), then stop a running edge and make sure it
# stopped. Only then does the change start, so a command that dies from
# here on, even by SIGKILL, leaves the stack blocked: make status and make
# url report it, and only a command that finished with every check passed
# clears it (gate_clear). The first line is the reason; the line "edge"
# records that the edge was serving, so a rotation can restore it.
# A failed listing is never taken for "no edge". Whether the edge stopped
# is checked on the containers listed before the stop (edges_stopped), not
# with a new listing: right after docker compose stop returned, the list
# can still show the stopped container as running.
protect_for() { # reason
  local edge='' ids rc
  ids=$(compose ps --quiet "$EDGE" 2>/dev/null) ||
    die $EX_SAFETY "could not list the containers of $PROJECT, so it is not known whether its edge serves; the database was not changed; stop the stack with make down"
  if [ -n "$ids" ] || grep -qx edge "$GATE_FILE" 2>/dev/null; then edge=edge; fi
  printf '%s\n' "$1" ${edge:+"$edge"} | write_gate || die $EX_SAFETY "could not record the security gate; nothing was changed"
  if [ -n "$ids" ]; then
    new_tmp edge-stop
    compose_op stop "$EDGE" >/dev/null 2>"$TMP_FILE"
    rc=$?
    # shellcheck disable=SC2086 # one container ID per word
    edges_stopped $ids ||
      die $EX_SAFETY "the edge of $PROJECT could not be stopped, so the database was not changed (docker compose stop exited with status $rc$(tail -n 1 "$TMP_FILE" | tr -cd '[:print:]' | head -c 200 | sed 's/^./: &/')); stop the stack with make down"
    log "stopped the edge before changing the database (${1}); it serves again once every check passed"
  fi
}

# Whether each container (ID) is stopped or removed. docker container
# inspect reads the container itself, not the list behind docker compose
# ps. Any other answer, or any other error, counts as running, and a call
# without IDs fails.
edges_stopped() { # id...
  local id s
  # No ID confirms nothing.
  [ "$#" -gt 0 ] || return 1
  for id in "$@"; do
    if s=$(docker container inspect -f '{{.State.Running}}' "$id" 2>&1); then
      [ "$s" = false ] || return 1
    else
      case $s in *"No such object"* | *"No such container"*) ;; *) return 1 ;; esac
    fi
  done
}

gate_clear() { rm -f "$GATE_FILE" "$RUNTIME_DIR/security-gate"; }

# What make status and make url show after a gate could not be recorded: a
# gate recorded earlier (for example by protect_for) is left in place by the
# failed write, so they still report the stack as blocked, with that reason.
gate_unrecorded_status() {
  local rec
  if rec=$(gate_record); then
    printf 'an earlier gate is still recorded, so make status and make url report the stack as blocked, but with its reason (%s)' "$(head -n 1 "$rec" | head -c 200)"
  else
    printf 'make status and make url do not report the stack as blocked'
  fi
}

# The recorded gate for read-only commands: also one an earlier version left
# at .runtime/security-gate (moved by the next command that prepares .runtime).
gate_record() {
  if [ -f "$GATE_FILE" ]; then printf '%s' "$GATE_FILE"
  elif [ -f "$RUNTIME_DIR/security-gate" ]; then printf '%s' "$RUNTIME_DIR/security-gate"
  else return 1
  fi
}

# The edge on the port answers a request for / with the security gate's 503
# (docker/edge/common.caddy): checked, not assumed, before an edge started
# while the gate is recorded is trusted to serve nothing.
gate_blocks() { # [port]
  (
    exec 3<>"/dev/tcp/$BIND/${1:-$COMPOSE_PORT}" || exit 1
    printf 'GET / HTTP/1.0\r\nHost: %s:%s\r\nConnection: close\r\n\r\n' "$BIND" "${1:-$COMPOSE_PORT}" >&3
    IFS= read -r -t 5 line <&3 || exit 1
    case $line in "HTTP/1."[01]" 503"*) ;; *) exit 1 ;; esac
    while IFS= read -r -t 5 line <&3; do
      case $line in '' | $'\r') break ;; esac
    done
    body=
    IFS= read -r -t 5 body <&3 || [ -n "$body" ] || exit 1
    case $body in *"blocked by its security gate"*) exit 0 ;; esac
    exit 1
  ) 2>/dev/null
}

# Before the edge is started while the gate is recorded: a one-off container
# of the edge service (it publishes no port) must show that its Caddy
# configuration has the gate rule and that the edge user can read the gate.
# An image built before the rule (a rotation does not build) or a gate the
# edge cannot read would let a started edge serve until the check after its
# start, and an interruption in between would leave it serving.
edge_sees_gate() {
  compose_op run --rm --no-deps -T --entrypoint sh "$EDGE" -c \
    'grep -q "blocked by its security gate" /etc/caddy/common.caddy && test -r /run/flowcrm-gate/security-gate' >/dev/null 2>&1
}

# Starts the edge on a port and accepts it only when it answers the
# readiness path with this stack's 200 (docker compose up --wait alone is not
# proof, see refresh_secret_mounts). While the security gate is recorded,
# the edge must also be seen answering everything else with the gate's 503
# first: the gate, not this process, keeps it from serving if the command is
# interrupted from here on. An edge that started but fails a check is
# stopped again (not removed); EDGE_FAILURE says why, and whether it is
# still running.
serve_edge() { # port
  EDGE_FAILURE=
  if try_edge "$1"; then
    LAST_ERROR=
    fault_point edge-started
    if [ -f "$GATE_FILE" ] && ! gate_blocks "$1"; then
      EDGE_FAILURE="it does not block requests while the security gate is recorded (expected the gate's 503 for /)"
    elif wait_http "$1"; then
      return 0
    else
      EDGE_FAILURE="it does not answer $READY_PATH with 200"
    fi
  else
    EDGE_FAILURE=$LAST_FAILURE
  fi
  edge_state
  if [ "$EDGE_RUNNING" = true ]; then
    if compose_op stop "$EDGE" >/dev/null 2>&1; then
      EDGE_FAILURE="$EDGE_FAILURE; the started edge was stopped"
    elif [ -f "$GATE_FILE" ] && gate_blocks "$1"; then
      EDGE_FAILURE="$EDGE_FAILURE; the started edge could not be stopped, but it answers only with the gate's 503 (checked); stop it with make down"
    else
      EDGE_FAILURE="$EDGE_FAILURE; WARNING: the started edge could not be stopped and was not seen blocking requests; stop the stack now: make down"
    fi
  fi
  return 1
}

# The last step of a rotation or abort that passed every check, while the
# security gate is still recorded (ADR-018, Rotation, state 7): if the gate
# had stopped a serving edge, start it on the saved port, where the gate
# keeps it from serving anything but its health paths; only once it answers
# readiness is the gate cleared, and it serves. If the edge does not get
# ready, the gate stays (with the reason), the edge is stopped and the
# command fails: the change itself is complete and verified, and make up
# serves once the cause is fixed. Interrupted anywhere here, even by
# SIGKILL, the gate is still recorded.
restore_edge() { # gate-had-edge what-was-done
  if [ "$1" != edge ] || [ "$STATE_STATUS" != valid ]; then
    gate_clear
    return 0
  fi
  fault_point restore-before-edge
  if ! edge_sees_gate; then
    gate_failed $EX_DOCKER "$2, but the edge was not started again: its image does not enforce the security gate or cannot read it (.runtime/gate); run make up, which rebuilds the images and serves once every check passed"
  fi
  if serve_edge "$STATE_PORT"; then
    gate_clear
    log "the edge serves again on port $STATE_PORT"
    return 0
  fi
  [ -z "$LAST_ERROR" ] || printf '%s\n' "$LAST_ERROR" >&2
  # gate_failed keeps the "edge" line already in the gate, so the next
  # rotation or abort brings the edge back too.
  gate_failed $EX_DOCKER "$2, but the edge did not serve again on port $STATE_PORT (${EDGE_FAILURE:-unknown}); the stack is not served: run make up once fixed (make logs edge api)"
}

sha256_of() { # file
  { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; } 2>/dev/null | cut -d' ' -f1
}

# Compose secrets are bind mounts of the host files. A running container
# does not see a file that was replaced on the host (rotation, restore from
# a backup): Docker Desktop shows it as missing, Linux keeps the replaced
# file. A running db or api whose mounted secrets differ from the host files
# is recreated. Compared by SHA-256 inside and outside; no value is shown.
stale_secrets() { # container -> names of mounted secrets that differ from the host files
  local name host inside stale=''
  for name in $(docker inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$1" 2>/dev/null | sed -n 's#^/run/secrets/##p'); do
    host=$(sha256_of "$SECRETS_DIR/$name")
    inside=$(docker exec "$1" sha256sum "/run/secrets/$name" 2>/dev/null | cut -d' ' -f1)
    if [ -z "$host" ] || [ "$inside" != "$host" ]; then stale="$stale $name"; fi
  done
  printf '%s' "${stale# }"
}

# A recreated service is checked here, not only by docker compose up --wait:
# Compose 2.38 on Linux was seen to exit 0 when the wait timeout expired
# while the new container was still starting (FND-009S). Passes only for a
# new container that is healthy and mounts the current secret files;
# otherwise RECREATE_STATE says what was found.
recreated_ok() { # service previous-container
  local id health stale
  RECREATE_STATE=
  id=$(compose ps --quiet "$1" 2>/dev/null | head -n 1)
  if [ -z "$id" ]; then RECREATE_STATE="no $1 container is running"; return 1; fi
  if [ "$id" = "$2" ]; then RECREATE_STATE="the $1 container was not replaced"; return 1; fi
  health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id" 2>/dev/null)
  if [ "$health" != healthy ]; then RECREATE_STATE="the new $1 container is not healthy (${health:-unknown})"; return 1; fi
  stale=$(stale_secrets "$id")
  if [ -n "$stale" ]; then RECREATE_STATE="the new $1 container does not mount the current $stale"; return 1; fi
}

refresh_secret_mounts() {
  local svc id stale rc
  [ -n "$ROLES" ] || return 0
  for svc in db api; do
    id=$(compose ps --quiet "$svc" 2>/dev/null | head -n 1)
    [ -n "$id" ] || continue
    stale=$(stale_secrets "$id")
    [ -n "$stale" ] || continue
    log "recreating $svc: its secret files changed on the host ( $stale )"
    new_tmp compose-err
    compose_op up --detach --wait --wait-timeout "$WAIT_TIMEOUT" --no-deps --force-recreate "$svc" >/dev/null 2>"$TMP_FILE"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      tail -n 20 "$TMP_FILE" >&2
      die $EX_DOCKER "recreating $svc with the current secret files failed: $(compose_failure "$rc"); run make up again after fixing the cause"
    fi
    if ! recreated_ok "$svc" "$id"; then
      tail -n 20 "$TMP_FILE" >&2
      die $EX_DOCKER "recreating $svc with the current secret files failed: docker compose reported success, but $RECREATE_STATE; run make up again after fixing the cause"
    fi
    rm -f "$TMP_FILE"
    TMP_FILE=
  done
}

# Fails closed unless the roles are complete; corrects role attributes and
# database, schema and default privileges (never passwords or ownership).
check_roles() {
  local rc
  [ -n "$ROLES" ] || return 0
  # Read-only first: only a database that needs corrections is protected and changed.
  db_roles check
  rc=$?
  if [ "$rc" -eq 20 ]; then
    protect_for "correcting the database role attributes and privileges"
    db_roles ensure
    rc=$?
  fi
  case $rc in
    0) ;;
    10) gate_failed $EX_SAFETY "the database of $PROJECT was created before role separation and still uses one account for everything; the stack is not served. Upgrade it explicitly, with a verified backup first: make db-upgrade-roles (docs/architecture/adr/ADR-018-database-roles.md)" ;;
    11) gate_failed $EX_SAFETY "the database roles of $PROJECT are inconsistent; nothing was changed and the stack is not served. See docs/architecture/adr/ADR-018-database-roles.md (Recovery): $(tail -n 2 "$TMP_FILE")" ;;
    12) gate_failed $EX_SAFETY "a database role secret is missing or malformed in the db container: $(tail -n 1 "$TMP_FILE")" ;;
    14) gate_failed $EX_SAFETY "an earlier database operation of $PROJECT could not be ended; nothing was changed: $(tail -n 1 "$TMP_FILE")" ;;
    *) tail -n 10 "$TMP_FILE" >&2; gate_failed $EX_DOCKER "checking the database roles failed: $(compose_failure "$rc")" ;;
  esac
  rm -f "$TMP_FILE"
  TMP_FILE=
}

# The api's own connection must be flowcrm_app and the database must match
# the runtime privilege manifest; otherwise the stack is not published.
verify_privileges() {
  local rc
  [ -n "$ROLES" ] || return 0
  new_tmp verify
  compose_op exec -T api php bin/console app:database:verify-privileges --runtime >"$TMP_FILE" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    grep -E '^VIOLATION|password authentication|SQLSTATE' "$TMP_FILE" | head -n 20 | sed 's/^/  /' >&2
    gate_failed $EX_SAFETY "the api's database role or privileges do not match config/database/runtime-privileges.yaml (shown above); the stack is not served. A failed login means .runtime/secrets/db_app_password does not match the database: make db-rotate-password ROLE=app"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

service_ids() {
  compose ps --all --format '{{.Service}}={{.ID}}' 2>/dev/null | sort
}

# Services whose container is new or was replaced since BEFORE.
changed_services() { # before
  local line names=''
  for line in $(service_ids); do
    case "
$1
" in *"
$line
"*) ;; *) names="${names:+$names }${line%%=*}" ;; esac
  done
  printf '%s' "$names"
}

# Returns 0 started, 1 port conflict, 2 other failure (details in
# LAST_ERROR and LAST_FAILURE). A terminated Compose call is never a conflict.
try_edge() {
  local rc
  COMPOSE_PORT=$1
  new_tmp compose-err
  compose_op up --detach --no-deps --wait --wait-timeout "$WAIT_TIMEOUT" "$EDGE" >/dev/null 2>"$TMP_FILE"
  rc=$?
  LAST_ERROR=$(tail -n 20 "$TMP_FILE")
  LAST_FAILURE=
  if [ "$rc" -ne 0 ]; then
    LAST_FAILURE=$(compose_failure "$rc")
    edge_state
    if [ "$rc" -le 128 ] && [ "$EDGE_RUNNING" != true ] && is_port_conflict "$TMP_FILE"; then rc=1; else rc=2; fi
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
  return "$rc"
}

add_candidate() {
  case " $CANDIDATES " in *" $1 "*) ;; *) CANDIDATES="${CANDIDATES:+$CANDIDATES }$1" ;; esac
}

build_candidates() { # [port to try first]
  local p
  CANDIDATES=
  if [ -n "$OVERRIDE" ]; then
    CANDIDATES=$OVERRIDE
    return 0
  fi
  if [ -n "${1-}" ] && in_range "$1"; then add_candidate "$1"; fi
  if [ "$STATE_STATUS" = valid ] && in_range "$STATE_PORT"; then add_candidate "$STATE_PORT"; fi
  add_candidate "$PORT_DEFAULT"
  p=$PORT_LO
  while [ "$p" -le "$PORT_HI" ]; do
    add_candidate "$p"
    p=$((p + 1))
  done
}

report_url() { printf '%s: http://%s:%s\n' "$URL_LABEL" "$BIND" "$1"; }

# --- commands ---------------------------------------------------------------

do_up() {
  local c rc deadline own='' restore='' skipped='' before changed
  case $STATE_STATUS in
    invalid) log "ignoring invalid .runtime/dev.env (it is replaced after a verified start)" ;;
  esac
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  ensure_secrets
  before=$(service_ids)
  build_images
  start_db
  check_roles
  start_internal
  refresh_secret_mounts
  apply_migrations
  fault_point up-after-migrations
  verify_privileges
  gate_clear
  edge_state

  if [ "$EDGE_RUNNING" = true ] && [ -n "$EDGE_PORT" ] && eligible "$EDGE_PORT"; then
    if ! edge_mounts_gate; then
      log "recreating the edge on port $EDGE_PORT: it does not mount .runtime/gate, so it would not enforce the security gate (created before FND-009E or outside make)"
    elif [ "$EDGE_HEALTH" = healthy ] && wait_http "$EDGE_PORT"; then
      if [ "$STATE_STATUS" != valid ] || [ "$STATE_PORT" != "$EDGE_PORT" ]; then
        [ "$STATE_STATUS" != valid ] ||
          log "saved port $STATE_PORT did not match the running edge ($EDGE_PORT); saved state updated"
        write_state "$EDGE_PORT"
      fi
      changed=$(changed_services "$before")
      if [ -z "$changed$MIGRATED" ]; then
        log "already running; nothing to change"
      else
        log "running; ${changed:+recreated: $changed (image or configuration changed)}${changed:+${MIGRATED:+; }}${MIGRATED:+applied pending database migrations}"
      fi
      report_url "$EDGE_PORT"
      return 0
    fi
    own=$EDGE_PORT
  elif [ "$EDGE_RUNNING" = true ] && [ -n "$EDGE_PORT" ]; then
    restore=$EDGE_PORT
  fi

  build_candidates "$own"
  deadline=$((SECONDS + UP_TIMEOUT))
  for c in $CANDIDATES; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      die $EX_NO_PORT "time budget of ${UP_TIMEOUT}s used up before a port could be bound (FLOWCRM_UP_TIMEOUT)"
    fi
    if [ "$c" != "$own" ] && port_in_use "$c"; then
      skipped="$skipped $c"
      continue
    fi
    try_edge "$c"
    rc=$?
    if [ "$rc" -eq 1 ]; then
      log "Docker could not bind $BIND:$c (port conflict); trying the next candidate"
      skipped="$skipped $c"
      continue
    fi
    if [ "$rc" -ne 0 ]; then
      printf '%s\n' "$LAST_ERROR" >&2
      die $EX_DOCKER "starting the edge on port $c failed for a reason other than a port conflict ($LAST_FAILURE); no other port was tried; containers were left for diagnosis: make status, make logs"
    fi
    edge_state
    [ "$EDGE_PORT" = "$c" ] ||
      die $EX_DOCKER "Docker reports the edge on $(show "$EDGE_PORT"), expected $BIND:$c; saved state not changed"
    wait_http "$c" || die $EX_DOCKER "the edge on port $c does not answer $READY_PATH with 200; saved state not changed; see make status and make logs"
    write_state "$c"
    [ -z "$skipped" ] || log "ports in use, skipped:$skipped"
    [ -z "$MIGRATED" ] || log "applied pending database migrations"
    report_url "$c"
    return 0
  done

  if [ -n "$restore" ]; then
    COMPOSE_PORT=$restore
    edge_state
    if [ "$EDGE_RUNNING" != true ] || [ "$EDGE_PORT" != "$restore" ]; then
      if serve_edge "$restore"; then
        log "the previous edge on port $restore was restored"
      else
        [ -z "$LAST_ERROR" ] || printf '%s\n' "$LAST_ERROR" >&2
        log "WARNING: could not restore the previous edge on port $restore ($EDGE_FAILURE)"
      fi
    else
      log "the running edge on port $restore was left unchanged"
    fi
  else
    COMPOSE_PORT=$PORT_DEFAULT
    edge_state
    if [ -n "$EDGE_ID" ] && [ "$EDGE_RUNNING" != true ]; then
      compose_op rm --force --stop "$EDGE" >/dev/null 2>&1
    fi
  fi
  if [ -n "$OVERRIDE" ]; then
    die $EX_NO_PORT "FLOWCRM_HTTP_PORT=$OVERRIDE cannot be bound (in use); no other port is tried for an explicit override"
  fi
  die $EX_NO_PORT "no free port in $PORT_LO-$PORT_HI (in use:$skipped); free one, or set FLOWCRM_PORT_RANGE or FLOWCRM_HTTP_PORT; see make ports"
}

do_down() {
  local rc
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  new_tmp compose-err
  compose_op down --remove-orphans >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    tail -n 20 "$TMP_FILE" >&2
    die $EX_DOCKER "stopping project $PROJECT failed: $(compose_failure "$rc")"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
  log "stopped project $PROJECT; volumes and .runtime/dev.env were kept"
}

# Rejects an invalid Compose file before anything is locked or started.
validate_compose() {
  local out
  if ! out=$(COMPOSE_PORT=$PORT_DEFAULT compose config --quiet 2>&1); then
    printf '%s\n' "$out" | tail -n 10 >&2
    die $EX_DOCKER "the Compose configuration ($COMPOSE_FILE_NAME) is invalid; nothing was started or changed"
  fi
}

locked() { # command
  preflight
  validate_compose
  ensure_runtime_dir
  acquire_lock "$1"
  read_state
  require_owned_project
}

cmd_up() {
  locked up
  do_up
}

cmd_down() {
  locked down
  do_down
}

cmd_restart() {
  locked restart
  do_down
  do_up
}

cmd_status() {
  local svc id s gate rc=$EX_NOT_RUNNING
  preflight
  read_state
  require_owned_project
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  printf 'project:    %s\ncheckout:   %s\n' "$PROJECT" "$ROOT"
  case $STATE_STATUS in
    valid) printf 'saved port: %s\n' "$STATE_PORT" ;;
    *) printf 'saved port: none (%s)\n' "$STATE_STATUS" ;;
  esac
  for svc in $INTERNAL_SERVICES $EDGE; do
    id=$(compose ps --all --quiet "$svc" 2>/dev/null | head -n 1)
    if [ -z "$id" ]; then
      printf '%-6s      absent\n' "$svc"
      continue
    fi
    s=$(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' "$id" 2>/dev/null)
    printf '%-6s      %s (%s) %s\n' "$svc" "${s%% *}" "${s#* }" "$(printf '%s' "$id" | cut -c1-12)"
  done
  edge_state
  if [ "$EDGE_RUNNING" = true ]; then
    printf 'mapping:    %s:%s -> %s\n' "$BIND" "${EDGE_PORT:-unknown}" "$EDGE_CONTAINER_PORT"
  fi
  if gate=$(gate_record); then
    printf 'blocked:    %s\n' "$(head -n 1 "$gate" | head -c 300)"
    printf 'result:     blocked by the security gate (a database change is in progress, was interrupted, or a check failed); fix the cause and run make up\n'
    return "$rc"
  fi
  if [ "$EDGE_RUNNING" = true ] && [ "$EDGE_HEALTH" = healthy ] && [ "$STATE_STATUS" = valid ] &&
    [ "$EDGE_PORT" = "$STATE_PORT" ]; then
    printf 'result:     running\n'
    rc=$EX_OK
  elif [ "$EDGE_RUNNING" = true ] && [ "$STATE_STATUS" = valid ] && [ "$EDGE_PORT" != "$STATE_PORT" ]; then
    printf 'result:     mapping does not match the saved port; run make up to reconcile\n'
  else
    printf 'result:     not running\n'
  fi
  return "$rc"
}

cmd_url() {
  local gate
  preflight
  read_state
  require_owned_project
  [ "$STATE_STATUS" = valid ] || die $EX_NOT_RUNNING "not started in this checkout (no verified port saved); run make up"
  ! gate=$(gate_record) || die $EX_NOT_RUNNING "blocked by the security gate: $(head -n 1 "$gate" | head -c 300)"
  COMPOSE_PORT=$STATE_PORT
  edge_state
  [ "$EDGE_RUNNING" = true ] || die $EX_NOT_RUNNING "the edge is not running; run make up"
  [ "$EDGE_PORT" = "$STATE_PORT" ] ||
    die $EX_NOT_RUNNING "the running edge uses $(show "$EDGE_PORT") but the saved port is $STATE_PORT; run make up to reconcile"
  http_ok "$STATE_PORT" || die $EX_NOT_RUNNING "the edge on port $STATE_PORT does not answer $READY_PATH with 200 (not ready)"
  printf 'http://%s:%s\n' "$BIND" "$STATE_PORT"
}

cmd_ports() {
  local p use who lsof_out='' docker_ok=''
  read_state
  build_candidates
  printf 'range %s-%s, default %s, override %s, saved %s\n' "$PORT_LO" "$PORT_HI" "$PORT_DEFAULT" \
    "${OVERRIDE:-none}" "${STATE_PORT:-none}"
  docker info >/dev/null 2>&1 && docker_ok=1
  if command -v lsof >/dev/null 2>&1; then
    lsof_out=$(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null)
  fi
  printf '%-6s %-10s %s\n' PORT PROBE 'PUBLISHED BY / LISTENER (best effort)'
  for p in $CANDIDATES; do
    if port_in_use "$p"; then use=in-use; else use=free; fi
    who=
    if [ -n "$docker_ok" ]; then
      who=$(docker ps --filter "publish=$p" --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')
    fi
    if [ -z "$who" ] && [ -n "$lsof_out" ]; then
      who=$(printf '%s\n' "$lsof_out" | awk -v p=":$p" 'index($9, p) && substr($9, length($9) - length(p) + 1) == p { print $1 }' | sort -u | tr '\n' ' ')
    fi
    printf '%-6s %-10s %s\n' "$p" "$use" "$who"
  done
}

is_log_service() { # name: exact match against the stack's services
  local s
  for s in $LOG_SERVICES; do [ "$1" = "$s" ] && return 0; done
  return 1
}

cmd_logs() {
  local svc=${SERVICE-} follow=${FOLLOW-0} tail=${TAIL-200} args
  if [ -n "$svc" ] && ! is_log_service "$svc"; then
    die $EX_CONFIG "SERVICE must be one of: ${LOG_SERVICES// /, } (got $(show "$svc"))"
  fi
  case $follow in 0 | 1) ;; *) die $EX_CONFIG "FOLLOW must be 0 or 1" ;; esac
  bounded_uint TAIL "$tail" 100000
  preflight
  read_state
  require_owned_project
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  args=(logs --no-color --tail "$tail")
  if [ "$follow" = 1 ]; then args+=(--follow); fi
  if [ -n "$svc" ]; then args+=("$svc"); fi
  compose "${args[@]}"
}

cmd_doctor() {
  local fail=0 v t
  check() { # level label command...
    local level=$1 label=$2
    shift 2
    if v=$("$@" 2>/dev/null); then
      printf 'ok    %-22s %s\n' "$label" "$(printf '%s' "$v" | head -n 1)"
    elif [ "$level" = required ]; then
      printf 'FAIL  %-22s required\n' "$label"
      fail=1
    else
      printf 'warn  %-22s optional, not available\n' "$label"
    fi
  }
  check required "bash" printf '%s' "$BASH_VERSION"
  check required "docker CLI" docker version --format '{{.Client.Version}}'
  check required "Docker daemon" docker version --format '{{.Server.Version}}'
  check required "Docker Compose v2" docker compose version --short
  for t in mktemp hostname ps find od tr; do check required "$t" command -v "$t"; done
  if command -v sha256sum >/dev/null 2>&1; then check required "sha256" command -v sha256sum; else check required "sha256" command -v shasum; fi
  check optional "make" sh -c 'make --version | head -n 1'
  check optional "lsof (diagnostics)" command -v lsof
  check required "$COMPOSE_FILE_NAME ($STACK)" test -f "$COMPOSE_FILE"
  if (load_config) 2>/dev/null; then
    printf 'ok    %-22s %s\n' "configuration" "valid"
  else
    printf 'FAIL  %-22s %s\n' "configuration" "$( (load_config) 2>&1 | sed 's/^devenv: ERROR: //')"
    fail=1
  fi
  printf 'project %s for %s\n' "$PROJECT" "$ROOT"
  [ "$fail" -eq 0 ] || return $EX_PREREQ
}

# --- explicit database role operations (ADR-018) -----------------------------

require_role_stack() {
  [ -n "$ROLES" ] || die $EX_CONFIG "$1 applies to the application stack only (FLOWCRM_STACK=app)"
  docker volume inspect "${PROJECT}_db-data" >/dev/null 2>&1 ||
    die $EX_SAFETY "the volume ${PROJECT}_db-data does not exist; a new volume is set up with its roles by make up, nothing to $2"
}

# Prints the role state. Runs in a command substitution, i.e. a subshell
# that does not share TMP_FILE with the caller, so it removes its own file.
roles_state() {
  if ! db_roles state; then
    tail -n 5 "$TMP_FILE" >&2
    rm -f "$TMP_FILE"
    die $EX_DOCKER "could not read the database role state"
  fi
  tr -d '[:space:]' <"$TMP_FILE"
  rm -f "$TMP_FILE"
}

# Explicit, owner-invoked upgrade of a volume created before role
# separation: verified backup (dumped, restored into a scratch database and
# compared), then the ownership change in one transaction, the migrations
# as flowcrm_owner and the privilege check. Re-running after success, or
# after an interruption, is safe.
cmd_upgrade_roles() {
  local state name dir dump sum host_sum rc
  locked upgrade-roles
  require_role_stack upgrade-roles "upgrade"
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  ensure_secrets allow-new-role-secrets
  build_images
  protect_for "upgrading the database roles"
  # A running api may still use an earlier configuration; stop it first.
  compose_op stop api web edge >/dev/null 2>&1
  start_db
  # The conversion reads the role passwords from the db container's mounts.
  refresh_secret_mounts
  state=$(roles_state)
  case $state in
    complete)
      log "the database roles are already separated; checking them"
      check_roles
      start_internal
      refresh_secret_mounts
      apply_migrations
      verify_privileges
      gate_clear
      log "nothing to upgrade; run make up to publish the stack"
      return 0
      ;;
    legacy) ;;
    *) die $EX_SAFETY "the database roles are $state; nothing was changed. See docs/architecture/adr/ADR-018-database-roles.md (Recovery)" ;;
  esac

  name=roles_upgrade_$(date -u +%Y%m%d%H%M%S)_$$
  dir=$RUNTIME_DIR/backups
  dump=$dir/$name.dump
  [ ! -L "$dir" ] || die $EX_SAFETY ".runtime/backups is a symbolic link; refusing to write through it"
  if ! { (umask 077 && mkdir -p "$dir") && chmod 0700 "$dir"; }; then
    die $EX_SAFETY "cannot create $dir; nothing was changed"
  fi
  [ ! -e "$dump" ] || die $EX_SAFETY "$dump already exists; nothing was changed"
  log "backing up the database and verifying the backup by restoring it into a scratch database (schema, every table's contents, migration history, triggers)"
  db_roles backup-verify "$name"
  rc=$?
  # On failure flowcrm-db-roles has already removed its unverified dump and the scratch database.
  [ "$rc" -eq 0 ] || { tail -n 5 "$TMP_FILE" >&2; die $EX_SAFETY "the backup could not be verified (exit $rc); nothing was changed"; }
  sum=$(tail -n 1 "$TMP_FILE" | tr -d '[:space:]')
  if ! [[ $sum =~ ^[0-9a-f]{64}$ ]]; then
    discard_dump "$name" ''
    die $EX_SAFETY "the backup check returned no checksum; nothing was changed"
  fi
  if ! (umask 077 && compose_op exec -T db cat "/tmp/$name.dump" >"$dump"); then
    discard_dump "$name" "$dump"
    die $EX_SAFETY "could not copy the backup to .runtime/backups; the incomplete copy was removed; nothing was changed"
  fi
  # Test-only: damage the copy, so the checksum comparison must catch it.
  [ "${FLOWCRM_DEVENV_FAULT-}" != upgrade-corrupt-copy ] || printf 'x' >>"$dump"
  host_sum=$(sha256_of "$dump")
  if [ "$host_sum" != "$sum" ]; then
    discard_dump "$name" "$dump"
    die $EX_SAFETY "the copied backup did not match the verified one (SHA-256) and was removed; nothing was changed"
  fi
  discard_dump "$name" ''
  fault_point upgrade-after-backup
  log "verified backup: .runtime/backups/$name.dump (sha256 $sum)"

  db_roles upgrade
  rc=$?
  [ "$rc" -eq 0 ] || { tail -n 5 "$TMP_FILE" >&2; die $EX_SAFETY "the role upgrade failed (exit $rc) and was rolled back; the backup is .runtime/backups/$name.dump"; }
  log "$(tail -n 1 "$TMP_FILE")"
  start_internal
  refresh_secret_mounts
  apply_migrations
  verify_privileges
  gate_clear
  log "upgraded to the database roles of ADR-018; run make up to publish the stack"
}

# Removes the dump of this upgrade from the db container's /tmp and, when
# given, the host copy made in this run (never a verified backup).
discard_dump() { # name [host copy]
  compose_op exec -T db rm -f "/tmp/$1.dump" >/dev/null 2>&1 ||
    log "WARNING: could not remove /tmp/$1.dump from the db container; it is removed by the next role operation or when the container is recreated"
  [ -z "$2" ] || rm -f "$2"
}

# Development-only rotation of the owner or runtime password, as a state
# machine whose state is the files in .runtime/secrets (ADR-018):
#
#   no pending file   the current file and the database agree (start state)
#   1 pending         .db_<role>_password.pending (0600, never mounted) holds
#                     the new password; the database may have either one
#   2 database        the database has the pending password (set by the
#                     superuser inside the db container, from standard input)
#   3 login           a SCRAM login with the pending password succeeded
#   4 promoted        the pending file replaced the current one (atomic mv)
#   5 refreshed       containers that mount the secret were recreated
#   6 verified        the api's own connection (app) or the migrate job
#                     (owner) logged in and the privileges match
#
# An interruption or failure in states 1-3 leaves the pending file: running
# the command again finishes the rotation with it, and
# rotate-db-password-abort gives the database the current password back.
# Both work whatever the database has, because the superuser sets the
# password; neither needs the old one. After state 4, make up (or running
# the command again) recreates the containers that still mount the replaced
# file. Nothing ever falls back to another role; passwords are never printed.
rotation_files() { # role -> sets ROT_CURRENT, ROT_PENDING
  ROT_CURRENT=$SECRETS_DIR/db_$1_password
  ROT_PENDING=$SECRETS_DIR/.db_$1_password.pending
}

rotation_role() {
  ROT_ROLE=${ROLE-}
  case $ROT_ROLE in
    app | owner) ;;
    *) die $EX_CONFIG "set ROLE=app or ROLE=owner (got $(show "$ROT_ROLE"))" ;;
  esac
}

valid_secret_file() { # file
  [ -f "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] && [[ $(cat "$1") =~ ^[0-9a-f]{48}$ ]]
}

# Login as flowcrm_<role> with the password in FILE, over SCRAM, inside the db container.
check_login() { # role file
  OP_STDIN=$2 db_roles check-login "$1"
}

# The role's own client proves the login: the api (app) or the migrate job (owner).
verify_role_client() { # role
  local rc
  if [ "$1" = app ]; then
    verify_privileges
    return 0
  fi
  new_tmp compose-err
  compose_op run --rm --no-deps -T migrate php bin/console app:database:verify-privileges >/dev/null 2>"$TMP_FILE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    grep -E '^VIOLATION|password authentication|SQLSTATE' "$TMP_FILE" | head -n 5 | sed 's/^/  /' >&2
    die $EX_SAFETY "the migrate job could not log in as flowcrm_owner with .runtime/secrets/db_owner_password, or the privileges differ (shown above)"
  fi
  rm -f "$TMP_FILE"
  TMP_FILE=
}

rotation_prepare() { # command
  rotation_role
  locked "$1"
  require_role_stack "$1" "rotate"
  COMPOSE_PORT=${STATE_PORT:-$PORT_DEFAULT}
  rotation_files "$ROT_ROLE"
  ensure_secrets
  start_db
  [ "$(roles_state)" = complete ] || die $EX_SAFETY "the database roles are not complete; rotate only after make up or make db-upgrade-roles"
  if [ -L "$ROT_PENDING" ] || { [ -e "$ROT_PENDING" ] && ! valid_secret_file "$ROT_PENDING"; }; then
    die $EX_SAFETY ".runtime/secrets/${ROT_PENDING##*/} is not a valid pending password (regular file of yours, 48 lowercase hex characters); remove it, then run make db-rotate-password-abort ROLE=$ROT_ROLE"
  fi
}

cmd_rotate_db_password() {
  local tmp rc had_edge=''
  rotation_prepare rotate-db-password
  if [ -e "$ROT_PENDING" ]; then
    log "resuming the unfinished rotation of flowcrm_$ROT_ROLE with its pending password"
  else
    tmp=$(mktemp "$SECRETS_DIR/.db_${ROT_ROLE}_password.XXXXXX") || die $EX_SAFETY "cannot create a temporary file in $SECRETS_DIR"
    TMP_FILE=$tmp
    if ! { chmod 0600 "$tmp" && od -An -N24 -tx1 /dev/urandom | tr -d ' \n' >"$tmp" && valid_secret_file "$tmp" && mv -f "$tmp" "$ROT_PENDING"; }; then
      die $EX_SAFETY "could not create the pending password; nothing was changed"
    fi
    TMP_FILE=
  fi
  fault_point rotate-after-pending

  protect_for "rotating the password of flowcrm_$ROT_ROLE"
  grep -qx edge "$GATE_FILE" && had_edge=edge
  OP_STDIN=$ROT_PENDING db_roles set-password "$ROT_ROLE"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    tail -n 3 "$TMP_FILE" >&2
    die $EX_SAFETY "setting the new password failed (exit $rc); the rotation is unfinished: run make db-rotate-password ROLE=$ROT_ROLE again to finish it, or make db-rotate-password-abort ROLE=$ROT_ROLE to keep the current password"
  fi
  fault_point rotate-after-db
  if ! check_login "$ROT_ROLE" "$ROT_PENDING"; then
    tail -n 2 "$TMP_FILE" >&2
    die $EX_SAFETY "flowcrm_$ROT_ROLE cannot log in with the new password; the rotation is unfinished: run make db-rotate-password ROLE=$ROT_ROLE again, or make db-rotate-password-abort ROLE=$ROT_ROLE"
  fi
  log "set a new password for flowcrm_$ROT_ROLE (SCRAM login checked)"

  if ! { chmod 0444 "$ROT_PENDING" && mv -f "$ROT_PENDING" "$ROT_CURRENT"; }; then
    die $EX_SAFETY "could not replace .runtime/secrets/db_${ROT_ROLE}_password with the pending password; run make db-rotate-password ROLE=$ROT_ROLE again"
  fi
  fault_point rotate-after-promote
  refresh_secret_mounts
  verify_role_client "$ROT_ROLE"
  log "rotated the password of flowcrm_$ROT_ROLE"
  restore_edge "$had_edge" "the password of flowcrm_$ROT_ROLE was rotated and verified"
}

cmd_rotate_db_password_abort() {
  local rc had_edge=''
  rotation_prepare rotate-db-password-abort
  [ -e "$ROT_PENDING" ] || { log "no unfinished rotation of flowcrm_$ROT_ROLE; nothing to abort"; return 0; }
  valid_secret_file "$ROT_CURRENT" ||
    die $EX_SAFETY ".runtime/secrets/db_${ROT_ROLE}_password is missing or malformed; restore it from a backup, or finish the rotation: make db-rotate-password ROLE=$ROT_ROLE"
  protect_for "restoring the password of flowcrm_$ROT_ROLE"
  grep -qx edge "$GATE_FILE" && had_edge=edge
  OP_STDIN=$ROT_CURRENT db_roles set-password "$ROT_ROLE"
  rc=$?
  [ "$rc" -eq 0 ] || { tail -n 3 "$TMP_FILE" >&2; die $EX_SAFETY "restoring the current password failed (exit $rc); nothing else was changed; run the command again"; }
  check_login "$ROT_ROLE" "$ROT_CURRENT" ||
    { tail -n 2 "$TMP_FILE" >&2; die $EX_SAFETY "flowcrm_$ROT_ROLE cannot log in with the current password after the abort; run the command again"; }
  rm -f "$ROT_PENDING"
  refresh_secret_mounts
  verify_role_client "$ROT_ROLE"
  log "aborted the rotation of flowcrm_$ROT_ROLE; the database uses the current password again (SCRAM login checked)"
  restore_edge "$had_edge" "the rotation of flowcrm_$ROT_ROLE was aborted and the current password verified"
}

main() {
  local cmd=${1:-help}
  [ $# -eq 0 ] || shift
  case $cmd in
    up | down | restart | status | url | ports | logs | doctor | upgrade-roles | rotate-db-password | rotate-db-password-abort) ;;
    __run-recorded)
      [ $# -ge 3 ] || die $EX_CONFIG "usage: bin/devenv __run-recorded LOCK_DIR TOKEN COMMAND..."
      run_recorded "$@"
      ;;
    help | -h | --help)
      usage
      return 0
      ;;
    *)
      usage >&2
      return $EX_CONFIG
      ;;
  esac
  [ $# -eq 0 ] || die $EX_CONFIG "unexpected arguments: $(show "$*")"
  init_paths
  if [ "$cmd" = doctor ]; then
    cmd_doctor
    return
  fi
  load_config
  # The command's own stdout and stderr, for on_signal.
  exec 8>&1 9>&2
  trap on_exit EXIT
  trap 'on_signal 130 INT' INT
  trap 'on_signal 143 TERM' TERM
  trap 'on_signal 129 HUP' HUP
  "cmd_${cmd//-/_}"
}

# Tests source this file to reach the functions without running main.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
