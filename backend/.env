# Non-secret defaults for the FlowCRM API. Real environment variables (set by
# compose.yaml) take precedence. Secrets are never stored here: they are read
# from files mounted as Docker Compose secrets (see *_FILE below).
# https://symfony.com/doc/current/configuration.html#configuration-based-on-environment-variables

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET_FILE=/run/secrets/app_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Absolute session lifetime in seconds, counted from the login (FCRM-002
# NFR-005: 8 hours). The idle timeout is session.gc_maxlifetime.
FLOWCRM_SESSION_ABSOLUTE_LIFETIME=28800

###> symfony/routing ###
# Base URI for URLs generated outside HTTP requests (CLI commands).
DEFAULT_URI=http://127.0.0.1
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=flowcrm
DATABASE_USER=flowcrm_app
DATABASE_PASSWORD_FILE=/run/secrets/db_app_password
###< doctrine/doctrine-bundle ###
