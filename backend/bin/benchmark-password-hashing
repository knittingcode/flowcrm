#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Measures Argon2id password verification (the cost of a login) with the
 * hasher Symfony uses, on the hardware it runs on, with as many parallel
 * workers as PHP-FPM may run at once (pm.max_children). Used to choose the
 * hashing parameters of a deployment (docs/architecture/authentication.md,
 * "Password hashing"). Prints the latency percentiles of one verification
 * under that concurrency, the throughput and the peak memory of a worker.
 *
 * Usage (in the api container, with its CPU and memory limits):
 *   php bin/benchmark-password-hashing [memory KiB] [passes] [workers] [verifications per worker]
 *   default: 19456 3 8 20
 */

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\PasswordHasher\Hasher\SodiumPasswordHasher;

$args = array_slice($argv, 1);
if ('--worker' === ($args[0] ?? null)) {
    [, $memory, $passes, $count] = array_map('intval', $args);
    $hasher = new SodiumPasswordHasher($passes, $memory << 10);
    $hash = $hasher->hash('benchmark passphrase');
    $times = [];
    for ($i = 0; $i < $count; ++$i) {
        $start = hrtime(true);
        if (!$hasher->verify($hash, 'benchmark passphrase')) {
            exit(3);
        }
        $times[] = (hrtime(true) - $start) / 1e6;
    }
    echo json_encode(['times' => $times, 'rss' => getrusage()['ru_maxrss']], \JSON_THROW_ON_ERROR), "\n";
    exit(0);
}

$memory = (int) ($args[0] ?? 19456);
$passes = (int) ($args[1] ?? 3);
$workers = (int) ($args[2] ?? 8);
$count = (int) ($args[3] ?? 20);

$pipes = [];
$processes = [];
$start = hrtime(true);
for ($i = 0; $i < $workers; ++$i) {
    $processes[$i] = proc_open([\PHP_BINARY, __FILE__, '--worker', (string) $memory, (string) $passes, (string) $count], [1 => ['pipe', 'w']], $pipes[$i]);
}
$times = [];
$rss = 0;
foreach ($processes as $i => $process) {
    $output = stream_get_contents($pipes[$i][1]);
    if (0 !== proc_close($process) || !is_string($output)) {
        fwrite(\STDERR, "a worker failed (out of memory?)\n");
        exit(1);
    }
    /** @var array{times: list<float>, rss: int} $result */
    $result = json_decode($output, true, flags: \JSON_THROW_ON_ERROR);
    $times = [...$times, ...$result['times']];
    $rss = max($rss, $result['rss']);
}
$seconds = (hrtime(true) - $start) / 1e9;
sort($times);
$percentile = static fn (float $p): float => $times[(int) floor($p * (count($times) - 1))];

printf(
    "Argon2id m=%d KiB t=%d, %d workers: p50 %.1f ms, p95 %.1f ms, max %.1f ms; %.1f verifications/s; peak memory per worker %d MiB\n",
    $memory, $passes, $workers, $percentile(0.5), $percentile(0.95), end($times), count($times) / $seconds, intdiv($rss, 1024),
);
